# MPiPi forcefield for slab simulation
#
# Joseph J A, Reinhardt A, Aguirre A, et al.
# Physics-driven coarse-grained model for biomolecular phase separation with
# near-quantitative accuracy[J].
# Nature Computational Science, 2021, 1(11): 732-743.
#
# Modified:
# - removed PTM entries
# - added RNA beads using lowercase one-letter codes: a c g u
# - bond length changed to 0.5 as requested

[ function-type ]
#  LJ              Couloumb
   Wang-Frenkel    Debye-Huckel

[ relative-permittivity ]
    80

[ simulation-setting ]
# name             value.  type_at_NVT       type_at_NPT
  shift-lj         True    forced            forced
  shift-coul       True    forced            forced
  cutoff_scheme_lj dynamic recommended       recommended
  cutoff_lj_multi  3.0     recommended       recommended
  cutoff-coul      3.5     recommended       recommended

[ residue-type ]
#   abbr   name     mass       charges
    E      GLU      129.11     -0.75
    D      ASP      115.09     -0.75
    R      ARG      156.19      0.75
    K      LYS      128.17      0.75
    I      ILE      113.16      0
    V      VAL      99.13       0
    L      LEU      113.16      0
    T      THR      101.11      0
    H      HIS      137.14      0.375
    M      MET      131.20      0
    G      GLY      57.05       0
    A      ALA      71.07       0
    C      CYS      103.14      0
    S      SER      87.08       0
    P      PRO      97.12       0
    N      ASN      114.10      0
    Q      GLN      128.13      0
    F      PHE      147.18      0
    Y      TYR      163.18      0
    W      TRP      186.22      0
    a      ADE      329.21     -0.75
    c      CYT      305.18     -0.75
    g      GUA      345.21     -0.75
    u      URA      306.17     -0.75

[ bond ]
## bond_name
  HPSBond
# bond_length  k
  0.381         8030
# Terminal-1-residue
H R K I F L W A M P C N V G S Q Y D E T
# Terminal-2-residue
H R K I F L W A M P C N V G S Q Y D E T

#bond_name
  RNABond
# bond_length  k
  0.500         8030
# Terminal-1-residue
a c g u
# Terminal-2-residue
a c g u

