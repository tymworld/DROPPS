# DROPPS molecular-dynamics parameter template
#
# Usage:
#   dps grompp -f system.pdb -p system.top -m md.mdp -o run.tpr
#   dps mdrun  -s run.tpr -o run
#
# Important: mdrun reads the generated TPR, not this MDP file. After changing
# the MDP, run grompp again. Parameter names may use '-' or '_'. Boolean values
# are case-sensitive and must be True or False.
#
# Units: time ps, length nm, temperature K, pressure bar, energy kJ/mol.
# Active nst-* output intervals use production steps; checkpointing is instead
# controlled by mdrun -cpt in wall-clock minutes (default: 5).
# Full reference: docs/mdp-reference.md

# 1. Integration and production length
integrator = Langevin       # Langevin dynamics; steep runs minimization only
dt         = 0.01           # Integration time step (ps)
nsteps     = 100000         # Production steps; warming steps are additional
friction   = 1.0            # Langevin friction coefficient (ps^-1)
seed       = 1215           # Integrator, velocity, and barostat random seed

# 2. Preparation and temperature
minimize   = True           # Minimize at fixed volume before a new run
forcetol   = 100            # Minimization force tolerance (kJ mol^-1 nm^-1)
max-step   = 100000         # Maximum minimization iterations

production-temperature = 300  # Production temperature (K)
gen-vel                = True # Generate Maxwell-Boltzmann velocities
initial-temperature    = 150  # Velocity-generation/warming start temperature (K)
warming-speed          = 1.0  # Heating/cooling rate when temperatures differ (K/ns)
keep-warming-trajectory = False # True writes <prefix>.warming.xtc per <=1 K stage

# 3. Bonds and center-of-mass motion
bondtype  = bond             # bond or constraint; pressure tensors require bond
comm-mode = Linear           # Linear removes center-of-mass translation; none disables
nstcomm   = 100              # Center-of-mass removal interval (steps)

# 4. Nonbonded interactions
# The topology force field may require or recommend particular values here.
vdwtype          = pLJ       # pLJ (Ashbaugh-Hatch) or MPiPi (Wang-Frenkel)
cutoff-scheme-lj = static    # static or dynamic
cutoff-lj        = 1.5       # Static LJ cutoff (nm)
cutoff-lj-multi  = 3.0       # Dynamic pair cutoff = this value * pair sigma
shift-lj         = True      # Shift LJ potential to zero at its pair cutoff

coulombtype = yukawa         # yukawa (Debye-Huckel) or no
cutoff-coul = 1.5            # Electrostatic cutoff (nm)
shift-coul  = True           # Shift electrostatic potential to zero at cutoff
salt-conc   = 0.1            # Salt concentration (mol/L)

# 5. Ensemble and pressure coupling
pcoulp = True                # True: NPT; False: fixed-volume NVT
ref-P  = 1                   # Barostat reference pressure (bar)
tau-P  = 5                   # Monte Carlo volume-change attempt interval (steps)

# 6. Trajectory and fixed progress logs
nst-xout      = 1000         # Write <prefix>.xtc; includes production step 0
nst-screenlog = 100000       # Fixed progress fields on screen
nst-filelog   = 10000        # Fixed progress fields in CSV <prefix>.log

# 7. Configurable thermodynamic output
# DROPPS .edr is a versioned CSV file, not a GROMACS binary EDR.
nst-energy  = 10000
energy-grps = potentialEnergy,kineticEnergy,totalEnergy,temperature,boxX,boxY,boxZ,volume,density

# Available energy-grps terms (step and time_ps are always written):
#   potentialEnergy, kineticEnergy, totalEnergy                  [kJ/mol]
#   temperature                                                  [K]
#   boxX, boxY, boxZ                                             [nm]
#   volume                                                       [nm^3]
#   density                                                      [g/mL]
#   pressure, Pxx, Pyy, Pzz, Pxy, Pxz, Pyz                      [kJ mol^-1 nm^-3]
# Pressure terms are expensive and require bondtype=bond and an orthorhombic box.

# 8. Optional standalone pressure-tensor XVG
# nst-stress and EDR pressure terms share the settings below. Enabling both
# computes the pressure tensor twice and is normally unnecessary.
nst-stress      = 0          # Write <prefix>.stress.xvg; 0 disables it
stress-strain   = 0.0003     # Central finite-difference strain (0 < value < 0.02)
stress-output   = auto       # auto -> <prefix>.stress.xvg
stress-platform = auto       # auto, CUDA, OpenCL, CPU, or Reference
stress-precision = double    # Precision for the auxiliary OpenMM Context
stress-device   = auto       # Device index, or auto
stress-threads  = 0          # CPU threads; 0 uses the OpenMM default

# 9. Reserved compatibility parameters
# These keys are accepted but currently do not affect the simulation. They are
# intentionally not active in this template: nst-cp, tcoulp, nstlist, buffer.
# Use mdrun -cpt to configure checkpoint minutes; nst-cp is retained only so
# older MDP/TPR files remain readable.
